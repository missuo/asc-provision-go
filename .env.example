# Apple App Store Connect API credentials
# https://developer.apple.com/documentation/appstoreconnectapi/creating_api_keys_for_app_store_connect_api
APPLE_KEY_ID=A1B2C3D4E5            # Key ID from App Store Connect
APPLE_ISSUER_ID=00000000-1111-2222-3333-444444444444  # Issuer ID from App Store Connect
APPLE_PRIVATE_KEY_PATH=private_keys/AuthKey_A1B2C3D4E5.p8  # Path to your private key file
APPLE_BUNDLE_ID=com.example.app     # Your app's bundle identifier

# API service configuration
PORT=8080                           # Port the server will listen on
API_KEY=your-secure-api-key-here    # API key for authentication (use a strong random value)

# For Docker Compose
APPLE_PRIVATE_KEY_FILENAME=AuthKey_A1B2C3D4E5.p8  # Just the filename of your private key